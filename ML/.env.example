# ─── TradeShield ML — environment template ────────────────────────────────────
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tradeshield_ml

# ── API Keys ──────────────────────────────────────────────────────────────────
# Primary FX source (required)
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY

# Macro / commodity feeds (all optional — pipeline degrades gracefully)
FRED_API_KEY=YOUR_FRED_API_KEY
WORLD_BANK_API_KEY=                 # public, no key needed — leave blank
QUANDL_API_KEY=YOUR_QUANDL_KEY

# ── Cache ─────────────────────────────────────────────────────────────────────
FX_CACHE_TTL_SECONDS=300            # 5 min live refresh
MACRO_CACHE_TTL_SECONDS=3600        # 1 h for slower macro data
PARQUET_CACHE_DIR=.cache/parquet    # git-ignored local Parquet cache

# ── Model / Forecast ──────────────────────────────────────────────────────────
FORECAST_HORIZON_DAYS=15            # business days ahead
PREDICTION_INTERVAL_LOWER=0.10      # 10th percentile
PREDICTION_INTERVAL_UPPER=0.90      # 90th percentile

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_RETRAIN_CRON=0 2 * * 1   # every Monday 02:00 UTC
SCHEDULER_INGEST_CRON=*/15 * * * * # every 15 min

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_ENV=development
